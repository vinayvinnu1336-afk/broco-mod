# ==============================================================================
# BroCo - environment for docker compose
# Copy to .env (git-ignored) and fill in every REQUIRED value.
# NEVER commit the real .env.
#
# Generate strong secrets with:   openssl rand -base64 48
# ==============================================================================

# Public site --------------------------------------------------------------------
# Your domain (used for HTTPS certificates) and the exact origin users browse to.
DOMAIN=example.com
PUBLIC_ORIGIN=https://example.com

# PostgreSQL + PostGIS -----------------------------------------------------------
POSTGRES_DB=broco_mod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=                      # REQUIRED - long random value

# API ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
JWT_SECRET=                             # REQUIRED - 64+ random characters
JWT_ISSUER=BroCoMod
JWT_AUDIENCE=BroCoModApp

# First Super Admin, created on first start only while no admin exists.
# Remove both values after your first login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=               # 12+ characters

# Abuse protection (per client, per minute)
AUTH_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=300

# Marketplace
DEFAULT_SEARCH_RADIUS_KM=10.0

# Money: customer pays this % of the price online when booking; the rest at the garage.
BOOKING_ADVANCE_PERCENT=10
# Garage commission (rate + GST are set in Admin -> Settings): due this many hours after handover,
# reminders every N hours, and garages with dues older than N days stop getting new jobs (0 = never block).
COMMISSION_DUE_HOURS=24
COMMISSION_REMINDER_HOURS=12
COMMISSION_BLOCK_AFTER_DAYS=3

# Job photos and videos (docs/architecture/media.md). Files live in the broco-mod-media Docker volume.
# Optional key for the short-lived links that show them (32+ characters); empty = derived from JWT_SECRET.
MEDIA_SIGNING_KEY=

# Google Maps (booking map, place search, address autofill, pincode check).
# Step-by-step guide: docs/google-maps-setup.md. Two keys from console.cloud.google.com:
#  - browser key: Maps JavaScript API + Places API, restricted to your domain (HTTP referrers)
#  - server key:  Geocoding API only, restricted to your VPS IP address
# Both are read by the API at startup: after pasting, run `docker compose up -d backend` (no rebuild).
# Leave empty to use the form without a map; "Use my current location" then fills the address
# from OpenStreetMap.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=
# Address autofill when no server key is set: OpenStreetMap (free, 1 lookup/second) or None.
GEOCODING_FALLBACK_PROVIDER=OpenStreetMap
# Optional, advanced: bake the browser key into the frontend build instead (a key change then
# needs `docker compose build frontend`). Leave empty.
GOOGLE_MAPS_BROWSER_KEY_AT_BUILD=

# Online payments (Razorpay) ---------------------------------------------------------
# Step-by-step guide: docs/razorpay-setup.md. Keys come from your own Razorpay dashboard
# (Settings -> API Keys). Test-mode keys start with rzp_test_ and move no real money; live keys start
# with rzp_live_. Never share the secret or commit it. Read at startup: `docker compose up -d backend`.
# PAYMENT_PROVIDER: Razorpay (real checkout) or DevelopmentFake (demo: marks payments paid, see below).
PAYMENT_PROVIDER=DevelopmentFake
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx       # key id from the dashboard (public, shown in checkout)
# RAZORPAY_KEY_SECRET=                          # key secret (shown once when the key is generated)
# RAZORPAY_WEBHOOK_SECRET=                      # secret you typed when creating the webhook (Settings -> Webhooks)

# Email, SMS and WhatsApp ---------------------------------------------------------------
# Step-by-step guide: docs/integrations-setup.md. Easiest way to fill these in on the server:
#   sudo bash /opt/broco-mod/scripts/deploy/set-keys.sh
# Empty = that channel is off (in-app notifications still work). Check with Admin -> System health.

# Email by Zoho ZeptoMail: password reset codes, booking confirmations, receipts, commission reminders.
# Token: ZeptoMail -> Mail Agents -> your agent -> Setup Info -> API -> "Send Mail Token" (secret).
ZEPTOMAIL_API_TOKEN=
# api.zeptomail.in for accounts in the India data centre (zeptomail.zoho.in), api.zeptomail.com otherwise.
ZEPTOMAIL_API_HOST=api.zeptomail.in
# Must be on a domain verified in ZeptoMail (Domains -> Add domain -> SPF + DKIM records).
EMAIL_FROM_ADDRESS=noreply@brocomob.com
EMAIL_FROM_NAME=BroCo

# SMS by Gupshup Enterprise (India, DLT). Every SMS text must be registered on your operator's DLT portal;
# the exact texts are in docs/integrations-setup.md. Gupshup or None (empty = Gupshup when user id + password are set).
SMS_PROVIDER=
GUPSHUP_SMS_USERID=                     # Enterprise SMS account number (digits)
GUPSHUP_SMS_PASSWORD=                   # secret: the Enterprise SMS login password
SMS_SENDER_ID=                          # 6-letter DLT header, e.g. BROCOM
DLT_ENTITY_ID=                          # Principal Entity ID from the DLT portal (digits)
# One DLT template id per message (digits from the DLT portal). A message whose id is empty is not sent by SMS.
DLT_TEMPLATE_OTP=                       # password reset / verification code (needed for reset by SMS)
DLT_TEMPLATE_BOOKING=                   # booking confirmed
DLT_TEMPLATE_QUOTE=                     # quotation ready
DLT_TEMPLATE_PAYMENT=                   # payment received
DLT_TEMPLATE_COMMISSION_REMINDER=       # garage commission due / overdue

# WhatsApp by Gupshup (optional). Codes go by WhatsApp first, then SMS if WhatsApp fails.
# Gupshup or None (empty = Gupshup when API key + source number are set).
WHATSAPP_PROVIDER=
GUPSHUP_WA_API_KEY=                     # secret: Gupshup dashboard -> your app -> API key
GUPSHUP_WA_SOURCE_NUMBER=               # WhatsApp business number with country code, e.g. 919876543210
GUPSHUP_WA_APP_NAME=                    # Gupshup app name (src.name)
WA_TEMPLATE_OTP=                        # Gupshup template id of the approved "Authentication" template

# Abuse protection for codes: per mobile/email and per client IP, in a 15-minute window.
OTP_MAX_PER_NUMBER=3
OTP_MAX_PER_IP=10

# Support contact shown on the website (leave empty to hide)
SUPPORT_PHONE=
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=                       # digits with country code, e.g. 919876543210

# Demo / staging only ---------------------------------------------------------------
# true = seed demo accounts (password Password123!) and show quick-login buttons.
ENABLE_DEMO_SEEDING=false
# true = allow the fake payment gateway (PAYMENT_PROVIDER=DevelopmentFake marks payments paid without real money).
ALLOW_FAKE_PAYMENTS=false

# Prebuilt images (optional - built by GitHub Actions "Release images", pulled on the VPS so a
# 4 GB server never builds). scripts/deploy/setup-server.sh fills these in; then deploy with
# `docker compose pull && docker compose up -d --no-build`. Leave commented to build locally.
# BACKEND_IMAGE=ghcr.io/vinayvinnu1336-afk/broco-mod-backend:latest
# FRONTEND_IMAGE=ghcr.io/vinayvinnu1336-afk/broco-mod-frontend:latest
# NGINX_IMAGE=ghcr.io/vinayvinnu1336-afk/broco-mod-nginx:latest
