# ==============================================================================
# BroCo Mod - Environment Variables Template
# NEVER COMMIT ACTUAL SECRETS, CREDENTIALS, OR API KEYS TO VERSION CONTROL.
# Copy this file to .env for local Docker Compose runs.
# ==============================================================================

# PostgreSQL & PostGIS Configuration
POSTGRES_DB=broco_mod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379
REDIS_PASSWORD=

# ASP.NET Core API Configuration
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5000
JWT_SECRET_KEY=replace_with_a_secure_random_key_min_32_chars
JWT_ISSUER=BroCoModPlatform
JWT_AUDIENCE=BroCoModAudience

# Next.js Frontend Configuration
FRONTEND_PORT=3005
NEXT_PUBLIC_API_URL=http://localhost:5000

# Geographic Search Parameters
DEFAULT_SEARCH_RADIUS_KM=10.0
MAX_SEARCH_RADIUS_KM=50.0
