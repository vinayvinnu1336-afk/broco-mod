# Local development overrides.
# Copy to docker-compose.override.yml (git-ignored) to run the stack on your own machine
# with demo accounts, the fake payment gateway and direct access to the database and API.
# NEVER use this file on a server that is reachable from the internet.

services:
  postgres:
    ports:
      - "5432:5432"

  redis:
    ports:
      - "6379:6379"

  backend:
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      Payment__AllowFakeGateway: "true"
      EnableDemoSeeding: "true"
      Swagger__Enabled: "true"
      Logging__LogLevel__Default: Debug
    ports:
      - "5000:5000"

  frontend:
    build:
      args:
        NEXT_PUBLIC_DEMO_MODE: "true"
    ports:
      - "3005:3000"
