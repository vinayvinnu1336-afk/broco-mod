{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=broco_mod;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "PlatformSettings": {
    "DefaultSearchRadiusKm": 10.0,
    "MaxSearchRadiusKm": 50.0
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "BroCoMod",
    "Audience": "BroCoModApp",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 10,
    "ApiPermitPerMinute": 300
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Payment": {
    "AllowFakeGateway": false
  }
}
