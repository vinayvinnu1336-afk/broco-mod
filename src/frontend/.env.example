# Copy to .env.local for local development. NEXT_PUBLIC_* values are baked into the browser bundle at build time.

# BroCo API base URL. Leave empty to use http://localhost:5000/api/v1 locally, or /api/v1 behind the reverse proxy.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Show one-tap demo sign-in buttons and demo helpers (always on with `next dev`).
NEXT_PUBLIC_DEMO_MODE=false

# Google Maps JavaScript API key (browser key, restrict it to your domains). Enables the map, Places search and
# reverse geocoding in the booking flow's location step. Needs: Maps JavaScript API, Places API (New), Geocoding API.
# Leave empty to use the manual address form with "Use my current location" instead.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
