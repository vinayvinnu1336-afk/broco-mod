# Copy to .env.local for local development. NEXT_PUBLIC_* values are baked into the browser bundle at build time.

# BroCo API base URL. Leave empty to use http://localhost:5000/api/v1 locally, or /api/v1 behind the reverse proxy.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Show one-tap demo sign-in buttons and demo helpers (always on with `next dev`).
NEXT_PUBLIC_DEMO_MODE=false

# Optional. Leave empty: the browser key is normally read from the API at runtime (GoogleMaps:BrowserApiKey,
# GOOGLE_MAPS_BROWSER_KEY in the root .env), so changing it needs only an API restart. Set it here only to bake
# a key into this build (it then wins over the API's key). See docs/google-maps-setup.md.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Public support contact shown in the header, booking card, "Need help?" and footer (leave empty to hide).
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=
# WhatsApp number, digits only with country code, e.g. 919876543210
NEXT_PUBLIC_SUPPORT_WHATSAPP=
